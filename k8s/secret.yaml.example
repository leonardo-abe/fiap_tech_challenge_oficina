# Template - NÃO commitar um secret.yaml com valores reais.
#
# Gere o secret de verdade a partir deste arquivo, por exemplo:
#   kubectl create namespace oficina --dry-run=client -o yaml | kubectl apply -f -
#   kubectl create secret generic oficina-secrets \
#     --namespace=oficina \
#     --from-literal=DATABASE_URL="postgresql+asyncpg://oficina:<senha>@postgres:5432/oficina" \
#     --from-literal=JWT_SECRET_KEY="$(python -c 'import secrets; print(secrets.token_urlsafe(32))')" \
#     --from-literal=SEED_ADMIN_SENHA="<senha-forte>" \
#     --from-literal=SEED_ATENDENTE_SENHA="<senha-forte>" \
#     --from-literal=SEED_MECANICO_SENHA="<senha-forte>"
#
# (os três últimos SMTP_* só são necessários se NOTIFICACAO_BACKEND=smtp no configmap.yaml)
apiVersion: v1
kind: Secret
metadata:
  name: oficina-secrets
  namespace: oficina
type: Opaque
stringData:
  DATABASE_URL: "postgresql+asyncpg://oficina:oficina@postgres:5432/oficina"
  JWT_SECRET_KEY: "troque-por-um-valor-gerado-com-secrets.token_urlsafe-32"
  SEED_ADMIN_SENHA: "troque-por-uma-senha-forte"
  SEED_ATENDENTE_SENHA: "troque-por-uma-senha-forte"
  SEED_MECANICO_SENHA: "troque-por-uma-senha-forte"
  # SMTP_HOST: "smtp.gmail.com"
  # SMTP_PORT: "587"
  # SMTP_USUARIO: "seu-usuario@gmail.com"
  # SMTP_SENHA: "app-password-de-16-caracteres"
  # SMTP_REMETENTE: "seu-usuario@gmail.com"

# Todas as variáveis abaixo são obrigatórias - a aplicação não sobe se alguma faltar,
# em qualquer ambiente, inclusive local (ver app/shared/settings.py).
APP_NAME="Oficina Mecânica API"
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://oficina:oficina@localhost:5432/oficina

# Só usadas pelo docker-compose.yml, para configurar o container do Postgres -
# troque em qualquer ambiente que não seja local/dev (e mantenha em sincronia com
# usuário/senha/banco embutidos em DATABASE_URL acima)
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina

# Só usadas pelo docker-compose.test.yml, para o Postgres efêmero (tmpfs) dos testes de
# integração - nunca guarda dado real, mas mesmo assim sem default no compose (ver
# app/shared/settings.py para o mesmo princípio aplicado à app).
TEST_POSTGRES_USER=oficina_test
TEST_POSTGRES_PASSWORD=oficina_test
TEST_POSTGRES_DB=oficina_test

# Obrigatória em qualquer ambiente, inclusive local - sem valor, a aplicação não sobe.
# O valor abaixo já é válido (>=32 bytes, RFC 7518 §3.2) pra facilitar subir o projeto
# rapidamente; gere uma sua caso vá além de teste/avaliação local:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=UFaFn45myrqE6gaKqaWFud4fqQy4LXzM4fkyQTHIXqg
JWT_EXPIRACAO_MINUTOS=60

# Credenciais dos usuários de teste criados por scripts/seed_usuarios.py (um por
# perfil - ADMIN/ATENDENTE/MECANICO) - obrigatórias em qualquer ambiente, inclusive
# local.
SEED_ADMIN_EMAIL=admin@oficina.com.br
SEED_ADMIN_SENHA=admin123
SEED_ATENDENTE_EMAIL=atendente@oficina.com.br
SEED_ATENDENTE_SENHA=atendente123
SEED_MECANICO_EMAIL=mecanico@oficina.com.br
SEED_MECANICO_SENHA=mecanico123

# Envio do orçamento ao cliente quando a OS entra em AGUARDANDO_APROVACAO.
# "log" (padrão seguro, sem dependência externa) apenas registra a notificação no log -
# use em dev/teste/CI. "smtp" envia e-mail de verdade e exige todos os campos SMTP_*
# abaixo (a aplicação não sobe com notificacao_backend=smtp e algum deles faltando).
NOTIFICACAO_BACKEND=log
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=seu-usuario@gmail.com
# SMTP_SENHA=app-password-de-16-caracteres-gerada-no-google
# SMTP_REMETENTE=seu-usuario@gmail.com

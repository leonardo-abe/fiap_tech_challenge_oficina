APP_NAME="Oficina Mecânica API"
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://oficina:oficina@localhost:5432/oficina

# Só usadas pelo docker-compose.yml, para configurar o container do Postgres -
# troque em qualquer ambiente que não seja local/dev (e mantenha em sincronia com
# usuário/senha/banco embutidos em DATABASE_URL acima)
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina

# Troque em qualquer ambiente que não seja local/dev - precisa ter pelo menos 32
# bytes (RFC 7518 §3.2) para HS256
JWT_SECRET_KEY=change-me-in-production-please-set-env-var
JWT_EXPIRACAO_MINUTOS=60

# Credenciais do admin criado por scripts/seed_admin.py (só para ambiente local)
SEED_ADMIN_EMAIL=admin@oficina.com.br
SEED_ADMIN_SENHA=admin123
